# Local development only. The source is mounted in by docker-compose.yml,
# so uvicorn --reload picks up changes without rebuilding the image.
FROM python:3.12-slim

WORKDIR /app

# the container runs as root; don't leave root-owned __pycache__ in the mounted source
ENV PYTHONDONTWRITEBYTECODE=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
